  "p_balloon": {
    "text": "소리를 잘 듣고, 맞는 글자 풍선을 터뜨려 봐!",
    "voice": "ko-KR-SunHiNeural",
    "rate": "-5%",
    "trim": true
  },
  "p_block": {
    "text": "소리를 잘 듣고, 블록을 붙여서 글자를 만들어 봐!",
    "voice": "ko-KR-SunHiNeural",
    "rate": "-5%",
    "trim": true
  },
  "p_coming_soon": {
    "text": "이곳은 곧 열려. 조금만 기다려 줘!",
