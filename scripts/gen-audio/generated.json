    "rate": "-5%",
    "trim": true
  },
  "p_hangul_title": {
    "text": "한글 모험!",
    "voice": "ko-KR-SunHiNeural",
    "rate": "-5%",
    "trim": true
  },
  "p_intro": {
    "text": "새로운 글자를 만나 보자! 글자를 눌러서 소리를 들어 봐.",
    "voice": "ko-KR-SunHiNeural",
    "rate": "-5%",
    "trim": true
  },
  "p_locked": {
    "text": "아직 잠겨 있어. 앞의 모험을 먼저 끝내 보자!",
    "voice": "ko-KR-SunHiNeural",
    "rate": "-5%",
    "trim": true
  },
  "p_map_welcome": {
    "text": "한글 모험에 온 걸 환영해! 반짝이는 곳을 눌러 봐.",
    "voice": "ko-KR-SunHiNeural",
    "rate": "-5%",
    "trim": true
  },
  "p_match": {
    "text": "그림과 맞는 글자를 짝지어 봐!",
    "voice": "ko-KR-SunHiNeural",
    "rate": "-5%",
    "trim": true
  },
  "p_pet_hatch": {
    "text": "알에서 아기 펫이 태어났어!",
    "voice": "ko-KR-SunHiNeural",
    "rate": "-5%",
    "trim": true
  },
  "p_pets": {
    "text": "내 펫과 스티커를 구경해 봐!",
    "voice": "ko-KR-SunHiNeural",
    "rate": "-5%",
    "trim": true
  },
  "p_profile_new": {
    "text": "새 친구를 만들어 볼까? 마음에 드는 펫을 골라 줘!",
    "voice": "ko-KR-SunHiNeural",
    "rate": "-5%",
    "trim": true
  },
  "p_profile_pick": {
    "text": "누구랑 놀까? 내 펫을 눌러 줘!",
