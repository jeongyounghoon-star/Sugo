# 참고용입니다. 직접 복사하지 말고 deploy/setup.ps1 을 실행하세요: 강한 랜덤 값으로 .env 를 만듭니다.
# (아래 자리표시자 값이 그대로 있으면 setup.ps1 이 설치를 멈춥니다.)
# .env 는 절대 커밋하지 마세요 (.gitignore 에 있음).

# DB 비밀번호 (영문/숫자 32자 이상). setup.ps1 이 64자 랜덤으로 생성
POSTGRES_PASSWORD=__generated_by_setup_ps1__

# 부모 PIN 해시에 섞는 비밀값 (DB/백업만으로는 PIN 을 풀 수 없게). setup.ps1 이 생성. 바꾸면 PIN 을 다시 만들어야 함
PIN_PEPPER=__generated_by_setup_ps1__

# 처음 부모 PIN 을 만들 때 필요한 설치 코드 (8자리). setup.ps1 이 생성해 화면에 보여 줌
SETUP_CODE=__generated_by_setup_ps1__

# 웹 포트와 바인드 주소 (특정 LAN IP에만 열고 싶으면 예: 192.168.0.10). IPv6 로는 열지 않는다
WEB_PORT=3000
WEB_BIND=0.0.0.0

# 이름으로 접속할 때 허용할 호스트 이름 (쉼표 구분). IP, localhost, *.local 은 항상 허용.
ALLOWED_HOSTS=

# 이미지 저장소. 실행할 이미지(SUGO_IMAGE)는 deploy/update.ps1 이 서명을 확인한 뒤
# "<저장소>@sha256:..." digest 로 채운다 (직접 :latest 를 적지 마세요).
SUGO_IMAGE_REPO=ghcr.io/jeongyounghoon-star/sugo
SUGO_IMAGE=

# 백업 폴더와 보관 개수 (일일 백업 14개 + 업데이트/복구 직전 백업 5개)
BACKUP_DIR=./backups
BACKUP_KEEP=14
BACKUP_PRE_KEEP=5
