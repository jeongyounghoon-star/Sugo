# 복사해서 .env 로 쓰세요. 보통은 deploy/setup.ps1 이 강한 랜덤 비밀번호로 자동 생성합니다.
# .env 는 절대 커밋하지 마세요 (.gitignore 에 있음).

# DB 비밀번호 (영문/숫자만, 32자 이상 권장)
POSTGRES_PASSWORD=__generated_by_setup_ps1__

# 웹 포트와 바인드 주소 (특정 LAN IP에만 열고 싶으면 예: 192.168.0.10)
WEB_PORT=3000
WEB_BIND=0.0.0.0

# 이름으로 접속할 때 허용할 호스트 이름 (쉼표 구분). IP, localhost, *.local 은 항상 허용.
ALLOWED_HOSTS=

# 실행할 이미지
SUGO_IMAGE=ghcr.io/jeongyounghoon-star/sugo:latest

# 백업 폴더와 보관 개수
BACKUP_DIR=./backups
BACKUP_KEEP=14
